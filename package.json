{
  "name": "qa-automation-lab",
  "version": "1.0.0",
  "description": "Portfólio de automação Web com Playwright, TypeScript e SauceDemo",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "docs:pdf": "python3 scripts/generate_manual.py",
    "test:demo": "node scripts/run-demo.cjs",
    "test:regression": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:login": "playwright test tests/login.spec.ts --project=chromium",
    "test:catalog": "playwright test tests/inventory.spec.ts --project=chromium",
    "test:cart": "playwright test tests/cart.spec.ts --project=chromium",
    "test:checkout": "playwright test tests/checkout.spec.ts --project=chromium",
    "check": "npm run quality && npm run test:chromium",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "quality": "npm run lint && npm run format:check && npm run typecheck",
    "docs:demo": "node scripts/record-demo.cjs"
  },
  "keywords": [],
  "author": "Adevanes (https://github.com/qadevanes-ti)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qadevanes-ti/qa-automation-lab.git"
  },
  "homepage": "https://github.com/qadevanes-ti/qa-automation-lab#readme",
  "engines": {
    "node": ">=22.13.0"
  }
}
